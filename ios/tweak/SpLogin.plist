/* SpLogin —— MobileSubstrate 过滤器 + 运行时配置（同文件双用途）
 *
 * MobileSubstrate / ElleKit 只读 Filter 段，其余键被忽略；tweak 自己再把这份
 * plist 读一遍当配置用，这样「开关」与「生效范围」永远在一起，不会漂移。
 *
 * 红线：SPLoginHostOverrideEnabled 默认 false —— 地址以编译期常量
 * （Makefile 的 SP_LOGIN_HOST，构建时 -D 注入）为准，plist 只能"覆写"不能"取代"。
 */
{
    Filter = {
        Bundles = (
            "com.leiting.wf"
        );
    };

    /* 地址覆写：默认关。打开后 SPLoginHost 生效（用于临时换机联调，不必重编）。 */
    SPLoginHostOverrideEnabled = false;
    SPLoginHost = "192.168.1.10:8001";

    /* 接管 SDK 登录界面：默认开。置 false 则完全不碰官方 UI（等价于只做网络改写）。 */
    SPLoginUITakeover = true;

    /* 把日志同时落盘（真机没有 Mac 时靠它取证）。默认开，写不进去就自动退回 NSLog。 */
    SPLoginLogToFile = true;

    /* 跳过官方隐私/协议弹窗（GDPRManage / ProtocolPrivacyPopView）。
     * 默认 false：这是官方 SDK 的合规流程，未经服主确认不擅自改。 */
    SPLoginSkipPrivacyDialogs = false;
}
